---
import PostRow from '../../components/PostRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { postHref, publishedPosts } from '../../lib/collections';

const posts = await publishedPosts();
---
<BaseLayout title="Writing · Blake Bailey" description="Posts by Blake Bailey on building AI agents that are safe to run, and on testing them.">
  <div class="container writing">
    <header class="writing__header">
      <h1>Writing</h1>
      <p class="lede">Notes on building AI agents that are safe to run, and on testing them. Follow along with the <a href="/rss.xml">RSS feed</a>.</p>
    </header>
    {posts.length > 0 ? (
      <ul class="posts">
        {posts.map((post) => (
          <PostRow title={post.data.title} href={postHref(post.id)} date={post.data.date} description={post.data.description} />
        ))}
      </ul>
    ) : (
      <p>No posts yet.</p>
    )}
  </div>
</BaseLayout>

<style>
  .writing { display: grid; gap: var(--space-6); padding-block: var(--space-7) 0; }
  .writing__header { display: grid; gap: var(--space-3); }
  .posts { list-style: none; margin: 0; padding: 0; max-width: var(--measure); }
</style>

---
import ResumeEntry from '../components/ResumeEntry.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { resume } from '../lib/resume';
import { site } from '../lib/site';

const contact = [site.location, site.phone, site.email, new URL(site.url).host, `github.com/${site.github.handle}`];
---
<BaseLayout
  title="Resume · Blake Bailey"
  description="Blake Bailey's resume: AI agents and automation, Preflight, race telemetry and vehicle diagnostics, and education."
>
  <article class="container resume">
    <header class="resume__header">
      <h1>{site.name}</h1>
      <p class="resume__contact">{contact.join(' · ')}</p>
      <p class="resume__download"><a href="/blake-bailey-resume.pdf">Download the PDF</a></p>
    </header>

    <section aria-labelledby="r-summary">
      <h2 id="r-summary">Summary</h2>
      <p>{resume.summary}</p>
    </section>

    <section aria-labelledby="r-skills">
      <h2 id="r-skills">Skills</h2>
      <dl class="resume__skills">
        {resume.skills.map((skill) => (
          <div><dt>{skill.group}</dt><dd>{skill.items}</dd></div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="r-experience">
      <h2 id="r-experience">Experience</h2>
      {resume.experience.map((entry) => <ResumeEntry entry={entry} />)}
    </section>

    <section aria-labelledby="r-projects">
      <h2 id="r-projects">Technical Projects</h2>
      {resume.projects.map((entry) => <ResumeEntry entry={entry} />)}
    </section>

    <section aria-labelledby="r-activities">
      <h2 id="r-activities">Leadership &amp; Athletics</h2>
      <ul>
        {resume.activities.map((activity) => <li>{activity}</li>)}
      </ul>
    </section>

    <section aria-labelledby="r-education">
      <h2 id="r-education">Education &amp; Licenses</h2>
      {resume.education.map((entry) => <ResumeEntry entry={entry} />)}
      <p><strong>Licenses:</strong> {resume.licenses}</p>
    </section>
  </article>
</BaseLayout>

<style>
  .resume { display: grid; gap: var(--space-6); padding-block: var(--space-7) 0; max-width: 56rem; margin-inline: auto; }
  .resume__header { display: grid; gap: var(--space-2); }
  .resume__contact { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-text); overflow-wrap: anywhere; }
  .resume section { display: grid; gap: var(--space-4); }
  .resume h2 {
    font-size: 0.8125rem; font-family: var(--font-mono); letter-spacing: var(--label-tracking);
    text-transform: uppercase; color: var(--color-accent); padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }
  .resume ul { margin: 0; padding-left: 1.25em; display: grid; gap: var(--space-1); }
  .resume__skills { display: grid; gap: var(--space-2); margin: 0; }
  .resume__skills div { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: var(--space-3); }
  .resume__skills dt { color: var(--color-heading); font-weight: 600; }
  .resume__skills dd { margin: 0; }
  @media (max-width: 36rem) {
    .resume__skills div { grid-template-columns: minmax(0, 1fr); gap: 0; }
  }
</style>

<style is:global>
  @page { size: Letter; margin: 0.5in 0.6in; }
  @media print {
    html, body { background: #fff !important; color: #1a1a1a !important; font-size: 9pt; line-height: 1.4; font-variant-ligatures: none; }
    .skip-link, .site-header, .site-footer, .resume__download { display: none !important; }
    .resume { padding: 0 !important; gap: 10pt !important; max-width: none !important; }
    .resume h1 { font-size: 20pt; color: #111 !important; }
    /* Normal letter-spacing in print: spaced-out capitals come out of the PDF as "S U M M A R Y". */
    .resume h2 { font-size: 9pt !important; letter-spacing: normal !important; color: #111 !important; border-bottom-color: #999 !important; padding-bottom: 2pt; }
    .resume h3, .resume dt, .resume strong { color: #111 !important; }
    .resume p, .resume li, .resume dd, .resume__contact, .entry__dates, .entry__link { color: #222 !important; }
    .resume a { color: #111 !important; text-decoration: none; }
    .resume section { gap: 5pt !important; }
    .resume ul { gap: 1pt !important; }
    .entry { gap: 2pt !important; }
  }
</style>

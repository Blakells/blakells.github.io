---
import { render } from 'astro:content';
import ChannelLabel from '../../components/ChannelLabel.astro';
import FactList from '../../components/FactList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { channel, featuredProjects, type Project } from '../../lib/collections';

export async function getStaticPaths() {
  const projects = await featuredProjects();
  return projects.map((project, index) => ({ params: { slug: project.id }, props: { project, index } }));
}

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const meta = [
  { label: 'Year', value: String(data.year) },
  { label: 'Built with', value: data.tags.join(', ') },
  { label: 'Source', value: data.repo.replace('https://', ''), href: data.repo },
  ...(data.play ? [{ label: 'Play', value: `blakells.dev${data.play}`, href: data.play }] : []),
];
---
<BaseLayout title={`${data.title} · Blake Bailey`} description={data.description}>
  <article class="container project">
    <header class="project__header">
      <ChannelLabel channel={channel(index)} name={data.label} />
      <h1>{data.title}</h1>
      <p class="lede">{data.summary}</p>
      <FactList items={meta} inline />
    </header>
    <div class="prose project__body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project { display: grid; gap: var(--space-6); padding-block: var(--space-7) 0; }
  .project__header { display: grid; gap: var(--space-4); padding-bottom: var(--space-6); border-bottom: 1px solid var(--color-border); }
  .project__body :global(.phone-shot) { max-width: 18rem; }
</style>

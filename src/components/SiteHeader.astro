---
import { site } from '../lib/site';

const links = [
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/resume/', label: 'Resume' },
  { href: '/writing/', label: 'Writing' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href);
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__mark" href="/"><span class="site-header__dot" aria-hidden="true"></span>{site.name}</a>
    <nav aria-label="Main">
      <ul class="site-header__nav">
        {links.map((link) => (
          <li><a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--color-border); }
  .site-header__inner {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: var(--space-3) var(--space-5); padding-block: var(--space-4);
  }
  .site-header__mark {
    display: inline-flex; align-items: center; gap: var(--space-3);
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: var(--label-tracking);
    text-transform: uppercase; text-decoration: none; color: var(--color-heading);
  }
  .site-header__dot { width: 6px; height: 6px; background: var(--color-accent); box-shadow: 0 0 8px rgb(255 91 31 / 0.7); }
  .site-header__nav { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); list-style: none; margin: 0; padding: 0; }
  .site-header__nav a {
    font-family: var(--font-mono); font-size: 0.8125rem; letter-spacing: 0.06em;
    color: var(--color-text); text-decoration: none; padding-block: var(--space-1);
  }
  .site-header__nav a:hover { color: var(--color-heading); }
  .site-header__nav a[aria-current='page'] { color: var(--color-heading); box-shadow: inset 0 -2px 0 var(--color-accent); }
</style>

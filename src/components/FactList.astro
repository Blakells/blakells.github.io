---
interface Fact {
  label: string;
  value: string;
  href?: string;
}
interface Props {
  items: Fact[];
  /** Lay the facts out in a row (the case-study meta row) instead of a stack. */
  inline?: boolean;
}
const { items, inline = false } = Astro.props;
---
<dl class:list={['facts', { 'facts--inline': inline }]}>
  {items.map((item) => (
    <div class="facts__row">
      <dt>{item.label}</dt>
      <dd>{item.href ? <a href={item.href}>{item.value}</a> : item.value}</dd>
    </div>
  ))}
</dl>

<style>
  .facts { display: grid; gap: var(--space-3); margin: 0; }
  .facts__row { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: var(--space-3); }
  .facts--inline { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); }
  .facts--inline .facts__row { display: grid; grid-template-columns: none; gap: var(--space-1); }
  dt {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--color-muted); padding-top: 0.25em;
  }
  dd { margin: 0; color: var(--color-heading); overflow-wrap: anywhere; }
  @media (max-width: 30rem) {
    .facts__row { grid-template-columns: minmax(0, 1fr); gap: var(--space-1); }
  }
</style>

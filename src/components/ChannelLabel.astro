---
interface Props {
  /** Two-digit channel number, for example "02". */
  channel: string;
  name: string;
}
const { channel, name } = Astro.props;
---
<p class="channel"><span class="channel__ch">CH·{channel}</span> / {name}</p>

<style>
  .channel {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .channel__ch { color: var(--color-accent); }
</style>

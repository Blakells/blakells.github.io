---
interface Stage {
  name: string;
  line: string;
}
interface Props {
  stages: Stage[];
}
const { stages } = Astro.props;
---
<ol class="pipeline">
  {stages.map((stage, index) => (
    <li class="pipeline__stage">
      <span class="pipeline__index">{String(index + 1).padStart(2, '0')}</span>
      <strong class="pipeline__name">{stage.name}</strong>
      <span class="pipeline__line">{stage.line}</span>
    </li>
  ))}
</ol>

<style>
  .pipeline {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: var(--space-3);
  }
  .pipeline__stage {
    display: grid; gap: var(--space-1); align-content: start;
    background: var(--color-panel); border: 1px solid var(--color-border); border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
  }
  .pipeline__index { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-accent); letter-spacing: var(--label-tracking); }
  .pipeline__name { font-family: var(--font-mono); color: var(--color-heading); }
  .pipeline__line { font-size: 0.9375rem; }
</style>
